{
  "name": "statecraft",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "updates:run": "tsx scripts/run-updates.ts",
    "updates:local": "tsx scripts/run-local-updates.ts",
    "publication:export": "tsx scripts/export-publication.ts",
    "publication:deploy": "node scripts/publish-local.mjs",
    "updates:setup": "tsx scripts/setup-update-checkpoints.ts",
    "updates:check": "node scripts/check-updates.mjs",
    "test:updates:migration": "node scripts/verify-updates-migration.mjs",
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "postinstall": "prisma generate",
    "backfill:briefings": "tsx --env-file=.env scripts/backfill-structured-briefings.ts",
    "audit:intelligence": "tsx scripts/audit-intelligence.ts",
    "mitre:update": "node scripts/update-attack-catalog.mjs",
    "test:intelligence:migration": "node scripts/verify-intelligence-migration.mjs",
    "test:pipeline:migration": "node scripts/verify-pipeline-migration.mjs",
    "test:cves:migration": "node --import tsx scripts/verify-cve-radar-migration.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.14.0",
    "@langchain/langgraph": "^1.7.5",
    "@langchain/langgraph-checkpoint-postgres": "^1.1.4",
    "@prisma/client": "^6.19.3",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tabs": "^1.1.13",
    "@types/dompurify": "^3.0.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.38.0",
    "groq-sdk": "^1.2.0",
    "htmlparser2": "^10.1.0",
    "lucide-react": "^1.16.0",
    "marked": "^18.0.3",
    "next": "16.2.6",
    "pg": "^8.23.1",
    "prisma": "^6.19.3",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "recharts": "^3.8.1",
    "rss-parser": "^3.13.0",
    "sanitize-html": "^2.17.4",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.17",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/sanitize-html": "^2.16.1",
    "@vitest/coverage-v8": "^4.1.6",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "tailwindcss": "^4",
    "tsx": "^4.19.4",
    "typescript": "^5",
    "vitest": "^4.1.6"
  }
}
