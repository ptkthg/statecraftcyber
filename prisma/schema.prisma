generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Briefing {
  id                String     @id @default(cuid())
  title             String
  slug              String     @unique
  summary           String     @db.Text
  content           String     @db.Text
  severity          Severity
  category          String
  tags              String[]
  affectedSectors   String[]
  affectedRegions   String[]
  sourceName        String
  sourceUrl         String
  sourcePublishedAt DateTime?
  /// @deprecated Use the Ioc relation table instead. Kept for snapshot compatibility.
  iocs              Json       @default("[]")
  /// Structured JSON content for the new rendering pipeline. Null for briefings generated before this field was added.
  structuredContent Json?
  cves              String[]
  mitreTechniques   String[]
  epssScore         Float?
  cvssScore         Float?
  confidence        Confidence
  status            Status     @default(draft)
  contentHash       String     @unique
  readingTime       Int        @default(5)
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt
  iocsRel           Ioc[]

  @@index([status, severity])
  @@index([status, createdAt(sort: Desc)])
  @@index([category])
}

model Ioc {
  id          String     @id @default(cuid())
  type        String
  value       String
  normalized  String
  confidence  Confidence
  sourceName  String?
  briefingId  String
  briefing    Briefing   @relation(fields: [briefingId], references: [id], onDelete: Cascade)
  createdAt   DateTime   @default(now())

  @@index([type])
  @@index([normalized])
  @@index([confidence])
  @@index([createdAt])
  @@index([briefingId])
  @@unique([type, normalized, briefingId])
}

model NewsCache {
  slug        String   @id
  title       String
  summary     String   @db.Text
  content     String   @db.Text
  source      String
  originalUrl String
  enrichedAt  DateTime @default(now())
}

model CveCache {
  id               String    @id
  published        DateTime
  lastModified     DateTime
  description      String    @db.Text
  cvssScore        Float?
  cvssVersion      String    @default("")
  severity         String?
  epss             Float?
  epssPercentile   Float?
  inCisaKev        Boolean   @default(false)
  affectedProducts String[]
  nvdUrl           String
  vulnType         String
  cweId            String    @default("")
  vulnExplanation  String
  fetchedAt        DateTime  @default(now())
  ptBrDescription  String?   @db.Text
  mitigation       String?   @db.Text
  aiPriority       String?
  enrichedAt       DateTime?

  @@index([severity])
  @@index([inCisaKev])
  @@index([fetchedAt])
  @@index([enrichedAt])
}

model CronLog {
  id               String   @id @default(cuid())
  runAt            DateTime @default(now())
  success          Boolean
  briefingsCreated Int      @default(0)
  errors           String[]
  sources          String[]
  durationMs       Int      @default(0)
}

enum Severity {
  critical
  high
  medium
  low
}

enum Confidence {
  high
  medium
  low
}

enum Status {
  draft
  published
}
